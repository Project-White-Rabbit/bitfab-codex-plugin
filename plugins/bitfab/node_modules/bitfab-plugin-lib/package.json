{
  "name": "bitfab-plugin-lib",
  "version": "0.1.0",
  "private": true,
  "description": "Shared library for Bitfab editor plugins (Claude Code, Cursor, etc.)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "postbuild": "node scripts/build-runtime-files.mjs && node scripts/build-skills.mjs",
    "dev": "tsc --watch",
    "dev:flows": "vite --config dev-server/vite.config.ts",
    "snapshot:parent": "node dev-server/scripts/snapshot-parent.mjs",
    "test": "vitest run",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "tsc": "tsc --noEmit && tsc --noEmit -p dev-server/tsconfig.json",
    "knip": "knip",
    "madge": "madge --ts-config ./tsconfig.json --extensions ts --circular ./src && madge --extensions ts,tsx --circular ./dev-server/src",
    "build:skills": "pnpm build",
    "validate": "pnpm lint && pnpm tsc && pnpm knip && pnpm madge && pnpm build"
  },
  "author": "Bitfab",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bitfab-flow": "workspace:*",
    "bitfab-lib": "workspace:*",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@xyflow/react": "^12.11.2",
    "elkjs": "^0.12.0",
    "mermaid": "^11.16.0",
    "react": "19.2.8",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "svg-pan-zoom": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
