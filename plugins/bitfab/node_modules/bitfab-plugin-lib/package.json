{
  "name": "bitfab-plugin-lib",
  "version": "0.1.0",
  "private": true,
  "description": "Shared library for Bitfab editor plugins (Claude Code, Cursor, etc.)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "postbuild": "node scripts/build-runtime-files.mjs && node scripts/build-skills.mjs",
    "dev": "tsc --watch",
    "dev:flows": "vite --config dev-server/vite.config.ts",
    "snapshot:parent": "node dev-server/scripts/snapshot-parent.mjs",
    "test": "vitest run",
    "test:cloud": "python3 -m unittest discover -s assets -p 'test_*.py' -v",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "tsc": "tsc --noEmit && tsc --noEmit -p dev-server/tsconfig.json",
    "knip": "knip",
    "build:skills": "pnpm build",
    "validate": "pnpm lint && pnpm tsc && pnpm knip && pnpm build"
  },
  "author": "Bitfab",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bitfab-flow": "workspace:*",
    "bitfab-lib": "workspace:*",
    "semver": "^7.8.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "esbuild": "0.28.1",
    "mermaid": "^12.1.0",
    "react": "19.3.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "svg-pan-zoom": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
