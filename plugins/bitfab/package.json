{
  "name": "bitfab-codex-plugin",
  "version": "0.12.83",
  "description": "Automated regression testing and improvements for your prompts, context, and tool calls.",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "tsc": "tsc --noEmit",
    "knip": "knip",
    "validate": "pnpm lint && pnpm tsc && pnpm knip && node ../scripts/check-bitfab-plugin-command-surface.mjs"
  },
  "keywords": [
    "codex",
    "bitfab",
    "llm",
    "evaluation",
    "tracing",
    "mcp"
  ],
  "author": "Bitfab",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
